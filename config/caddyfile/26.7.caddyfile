# Maho site configuration for FrankenPHP, for Maho 26.7 and later.
#
# 26.7 introduced the API Platform entry point, public/rest.php, and with it the
# /api/* routing below. Add a new template here when a later Maho version needs
# different rules, and point the affected rows of versions.json at it. Do not
# edit this file in place for a change that only applies to a newer version.
#
# This file replaces the default Caddyfile of the dunglas/frankenphp base image.
# The base file serves a plain PHP application: it has no /api/* routing and no
# file access rules, so an API request reaches index.php and fails there.
#
# Keep this file in sync with the reference implementation in Maho itself,
# public/.htaccess, and with https://mahocommerce.com/hosting/web-server/
{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	encode zstd br gzip

	header X-Content-Type-Options "nosniff"

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Caddy sorts directives by type, not by source order. The rewrites below
	# depend on each other, so they must sit in a route block, which does run
	# its directives in source order.
	route {
		# TRACE and TRACK allow cross-site tracing.
		@trace method TRACE TRACK
		respond @trace 405

		# Hidden files. /.well-known/ is a registered path prefix (RFC 8615),
		# not a hidden file, and /.thumbs/ holds the thumbnails of the admin
		# media browser. Go regular expressions have no negative lookahead, so
		# the exceptions are separate "not" conditions.
		@hidden {
			path_regexp hidden /\.
			not path /.well-known/*
			not path_regexp thumbs /\.thumbs/
		}
		respond @hidden 404

		# File types that disclose the installation. The exempt names are generated
		# by PHP, so no file exists for them, but this rule runs before the rewrites
		# and would still deny them. Go regular expressions have no negative
		# lookbehind, so the exceptions are `not path` lines.
		#
		# The exemption list follows Maho main. The .htaccess of 26.7.x exempts only
		# robots.txt and manifest.json, so it also denies /api/docs.json, which its
		# own API serves. That is an upstream bug fixed later; this file keeps the
		# fixed behaviour rather than reproducing it on the 26.7.x image tags.
		@private {
			path *.txt *.json *.dist *.flag *.ip *.lock *.md *.neon *.sample *.sh *.yaml *.yml
			not path /robots.txt /llms.txt /manifest.json /api/docs.json
			not path /.well-known/mcp.json /.well-known/mcp/server-card.json
		}
		respond @private 404

		# ---- API routing ----
		#   /api/rest/v2/*     -> rest.php           REST v2, Symfony API Platform
		#   /api/graphql       -> rest.php           GraphQL, public
		#   /api/admin/graphql -> rest.php           GraphQL, admin
		#   /api/mcp           -> rest.php           MCP, for AI agents
		#   /api/docs          -> rest.php           OpenAPI docs and Swagger UI
		#   /api/rest          -> api.php?type=rest  legacy Magento 1 REST
		#   /api/soap          -> index.php          Mage_Api_SoapController
		#   /api/v2_soap       -> index.php          Mage_Api_V2_SoapController
		#   /api/xmlrpc        -> index.php          Mage_Api_XmlrpcController
		#   /api/jsonrpc       -> index.php          Mage_Api_JsonrpcController
		#   any other /api/*   -> rest.php
		#
		# Order matters twice: /api/rest/v2 must be tested before /api/rest, and
		# the SOAP and RPC paths must be excluded from the final catch-all.
		#
		# Do not add CORS headers here. Maho answers CORS and the OPTIONS
		# preflight inside the API kernel, configured in
		# System > Configuration > Services > API > CORS Allowed Origins.
		@api_v2 {
			path_regexp api_v2 ^/api/rest/v2(/|$)
			not file
		}
		rewrite @api_v2 /rest.php

		# A rewrite that writes its own query string replaces the original one,
		# so the placeholder puts the original back. This is Apache's [QSA].
		@api_legacy_rest {
			path_regexp api_legacy_rest ^/api/rest(/|$)
			not file
		}
		rewrite @api_legacy_rest /api.php?type=rest&{http.request.uri.query}

		@api_other {
			path_regexp api_other ^/api(/|$)
			not path_regexp api_legacy_rpc ^/api/(soap|v2_soap|xmlrpc|jsonrpc)(/|$)
			not file
		}
		rewrite @api_other /rest.php
		# ---- End API routing ----

		php_server
	}
}

# Site blocks dropped into Caddyfile.d are included, as in the base image.
import Caddyfile.d/*.caddyfile
